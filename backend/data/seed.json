  "questions": [
    {
      "id": "q.num.integers.01",
      "prompt": "Which of the following is the additive inverse of -7?",
      "options": [
        {
          "id": "a",
          "text": "7"
        },
        {
          "id": "b",
          "text": "-7"
        },
        {
          "id": "c",
          "text": "1/7"
        },
        {
          "id": "d",
          "text": "0"
        }
      ],
      "correct_option_id": "a",
      "answer_rubric": "The additive inverse of x sums with x to zero: -7 + 7 = 0.",
      "target_concept_id": "num.integers",
      "prerequisite_tags": [],
      "difficulty": "easy",
      "reviewed": true
    },
    {
      "id": "q.num.operations.01",
